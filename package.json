{
  "name": "orchestra-dsh",
  "version": "0.4.0",
  "description": "Orchestra — DSH multi-role topology collaboration. A2A transport across agent threads plus governed topology management: living document + charter draft/freeze/approve, bounded graph runtime (loop/attempt/verdict/gate/closure), transactional role provisioning, seven v0.4 role presets, five task topologies (feature-development / bug-diagnosis-and-fix / architecture-decision / refactor-and-migration / audit-and-hardening), driver node-milestone notices and proposal blueprint tables.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/bundle-root.d.ts",
      "default": "./lib/bundle-root.js"
    },
    "./a2a": {
      "types": "./lib/a2a.d.ts",
      "default": "./lib/a2a.js"
    },
    "./orchestra": {
      "types": "./lib/orchestra.d.ts",
      "default": "./lib/orchestra.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && tsdown",
    "dev": "node --import tsx scripts/loader.mjs",
    "dev:harness": "dsh web --patch ./cordis.patch.yml",
    "test": "npm run build && node --test scripts/test-v0.3.0.mjs scripts/test-orchestra-state.mjs scripts/test-orchestra-archive.mjs scripts/test-orchestra-topology.mjs scripts/test-session-blueprint.mjs scripts/test-governed-provisioning.mjs scripts/test-orchestra-role-presets.mjs scripts/test-a2a-transport.mjs scripts/test-orchestration-document.mjs scripts/test-orchestration-charter.mjs scripts/test-orchestra-graph.mjs scripts/test-feature-development.mjs scripts/test-bug-diagnosis-and-fix.mjs scripts/test-architecture-decision.mjs scripts/test-refactor-and-migration.mjs scripts/test-audit-and-hardening.mjs scripts/test-recovery.mjs scripts/test-cp8-notices.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json",
    "prepare": "npm run build"
  },
  "keywords": [
    "dsh",
    "plugin",
    "cordis",
    "bundle",
    "orchestra",
    "a2a",
    "multi-agent",
    "topology"
  ],
  "license": "MIT",
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/cordis-plugin-timer": "^1.1.3",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-presets": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-fs": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-permission-presets": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-sandbox": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-sandbox-policy": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session-title": "0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@types/node": "^22.10.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.7",
    "react": "^18.2.0",
    "tsdown": "0.22.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "@deepseek-ai/cordis-plugin-timer": "^1.1.3",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-presets": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-fs": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-permission-presets": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-sandbox": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-sandbox-policy": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  }
}
